    "SKILL.md",
    "README_CN.md",
    "agents",
    "references",
    "evals",
    "bin",
    "lib"
  ],
  "scripts": {
    "test": "node --test \"node-tests/**/*.test.mjs\"",
    "doctor": "node bin/hellosearch.mjs doctor",
    "pack:dry": "npm pack --dry-run"
