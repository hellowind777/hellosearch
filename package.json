{
  "name": "hellosearch",
  "version": "1.0.1",
  "description": "Host-agnostic deep-research skill for AI agents: a pure-instruction methodology for planning, searching, verifying, and citing on the live web, with a multi-host installer.",
  "type": "module",
  "private": false,
  "bin": {
    "hellosearch": "bin/hellosearch.mjs"
  },
